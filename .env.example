# ============================================================
# KESAVA CAREER COMMAND CENTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and supply your private credentials
# NEVER commit .env to public version control!
# ============================================================

# Application Security
SECRET_KEY=your-cryptographically-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL=sqlite:///./career_command.db

# AI Provider Credentials (Optional - Falls back to local deterministic engine if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Career Target Parameters
TARGET_MIN_CTC_LPA=18.0
CURRENT_CTC_LPA=3.5
EXPERIENCE_YEARS=1.6
